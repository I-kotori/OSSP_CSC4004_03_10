{
  "manifest_version": 3,
  "name": "YouTube Comment Analyzer",
  "version": "1.0.0",
  "description": "YouTube 댓글 여론 분석 UI를 추가합니다.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}